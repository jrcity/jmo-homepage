# Copy to .env.local and fill in real values.

# URL of the deployed BizHub app — the "/bizhub" nav item redirects here.
NEXT_PUBLIC_BIZHUB_URL=https://bizhub.jmo.co

# URL of the deployed Media app — the "/media" nav item redirects here.
NEXT_PUBLIC_MEDIA_URL=https://media.jmo.co

# URL of the deployed Academy app — the "/academy" nav item redirects here.
NEXT_PUBLIC_ACADEMY_URL=https://academy.jmo.co

# Shared identity service base URL for centralized authentication across all 4 products.
NEXT_PUBLIC_IDENTITY_SERVICE_URL=https://auth.jmo.co
